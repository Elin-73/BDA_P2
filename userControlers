
def create_memgraph(connection):
    print("Seleccione lo que necesita crear:")
    print("1. Crear un nodo de tipo 'Propiedad' con atributos: id, direccion, precio, habitaciones, baños, metros_cuadrados")
    print("2. Crear un nodo de tipo 'Cliente' con atributos: id, nombre, correo_electronico, telefono")
    print("3. Crear un nodo de tipo 'Asesor' con atributos: id, nombre, correo_electronico, telefono")

    opcion = input("Ingrese el número de la opción deseada: ")
    if opcion == "1":
        id = input("Ingrese el id de la propiedad: ")
        direccion = input("Ingrese la dirección de la propiedad: ")
        precio = input("Ingrese el precio de la propiedad: ")
        habitaciones = input("Ingrese el número de habitaciones: ")
        baños = input("Ingrese el número de baños: ")
        metros_cuadrados = input("Ingrese los metros cuadrados: ")

        query = f"""
        CREATE (p:Propiedad {{
            id: '{id}',
            direccion: '{direccion}',
            precio: {precio},
            habitaciones: {habitaciones},
            baños: {baños},
            metros_cuadrados: {metros_cuadrados}
        }})
        """
    elif opcion == "2":
        id = input("Ingrese el id del cliente: ")
        nombre = input("Ingrese el nombre del cliente: ")
        correo_electronico = input("Ingrese el correo electrónico del cliente: ")
        telefono = input("Ingrese el teléfono del cliente: ")

        query = f"""
        CREATE (c:Cliente {{
            id: '{id}',
            nombre: '{nombre}',
            correo_electronico: '{correo_electronico}',
            telefono: '{telefono}'
        }})
        """
    elif opcion == "3":
        id = input("Ingrese el id del asesor: ")
        nombre = input("Ingrese el nombre del asesor: ")
        correo_electronico = input("Ingrese el correo electrónico del asesor: ")
        telefono = input("Ingrese el teléfono del asesor: ")

        query = f"""
        CREATE (a:Asesor {{
            id: '{id}',
            nombre: '{nombre}',
            correo_electronico: '{correo_electronico}',
            telefono: '{telefono}'
        }})
        """
    else:
        print("Opción inválida. Por favor, intente de nuevo.")
        return
    results = connection.execute_and_fetch(
            query
        )
    return print("Created node with message:", next(results)["message"])

